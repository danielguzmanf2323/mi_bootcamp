# =============================================================
# Datos — no subir datasets al repositorio
# Los datos van en Google Drive: data_engineering_files/semana_XX/
# =============================================================
*.csv
*.parquet
*.avro
*.jsonl
*.xlsx
*.xls
*.tsv
*.orc

# JSON de datos crudos por carpeta (evita bloquear configs del proyecto)
**/data/**/*.json
**/datasets/**/*.json
**/raw/**/*.json
**/landing/**/*.json

# Excepción: archivos de ejemplo pequeños (< 1MB) sí se versionan
!recursos/datasets/ejemplos/**

